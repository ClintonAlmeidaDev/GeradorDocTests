<?xml version="1.0" encoding="UTF-8"?>
<!-- Use only with the repository URL and credentials approved by your company.
     The repository manager must proxy dependencies AND Maven plugins.
     Do not commit real credentials. Do not replace your global settings automatically. -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>corporate</id>
      <url>${env.CORPORATE_MAVEN_URL}</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>corporate</id>
      <username>${env.CORPORATE_MAVEN_USER}</username>
      <password>${env.CORPORATE_MAVEN_TOKEN}</password>
    </server>
  </servers>
</settings>
